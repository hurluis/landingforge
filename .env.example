# ---- IA ----
# Sin clave, la aplicación corre entera contra lib/ia/mock.ts.
# NUNCA uses el prefijo NEXT_PUBLIC_ aquí: se inyecta en el bundle del navegador.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# ---- Persistencia ----
# La URL decide el motor, y es la única señal: no hay una bandera aparte que
# se pueda quedar desincronizada.
#
#   Un nombre de archivo  -> SQLite en datos/<nombre>. Es el modo por defecto,
#                            y no exige instalar ni configurar nada.
#   postgres://... o
#   postgresql://...      -> PostgreSQL.
#
# Para Postgres en local (Postgres.app o Homebrew), creando la base antes:
#   createdb landingforge
#   DATABASE_URL=postgresql://TU_USUARIO@localhost:5432/landingforge
#
# El esquema se crea solo en el primer arranque; no hay paso de migración.
DATABASE_URL=landingforge.db

# ---- Sesión ----
AUTH_SECRET=   # genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Banderas ----
FEATURE_GENERACION_IMAGENES=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Administración ----
# Correos que se promueven a administrador la primera vez que entran, separados
# por coma. Resuelve el arranque: nadie puede crear al primer administrador
# desde un panel al que todavía no puede entrar. Después de esa primera vez la
# fuente de verdad es la columna `rol` y los admins se gestionan desde /admin.
ADMIN_EMAILS=
