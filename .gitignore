# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local de SQLite
/datos

# configuración local de editores y asistentes — no es parte del producto
/.claude
/.agents
/.codex
/skills-lock.json
/AGENTS.md
/CLAUDE.md

# capturas de revision visual
/.capturas

# el máster de la toma de producto: pesa 22 MB y de él solo se versionan
# los fotogramas de public/secuencia (npm run fotogramas los reconstruye)
/Video

# originales de las secciones: pesan 14 MB y de ellos solo se versionan
# las versiones servidas en public/secciones
/Landingparts

# Grafo de conocimiento del repositorio: se reconstruye con /graphify.
graphify-out/
